<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/redactObjectBook"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".RedactDiskActivity"
    >

    <TextView
        android:id="@+id/zagol"
        android:text="Редактировать элемент"
        android:textSize="28sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <Button
        android:id="@+id/buttonRedactObject"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:textSize="22sp"
        android:text="Редактировать"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        tools:text = "Название"
        android:id="@+id/nameObject"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:ems="10"
        android:inputType="text"
        android:layout_marginLeft="160dp"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toBottomOf="@id/zagol"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/textViewName"
        android:textSize="16sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Название:"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        app:layout_constraintTop_toTopOf="@id/nameObject"
        app:layout_constraintEnd_toStartOf="@id/nameObject" />

    <RadioGroup
        android:id="@+id/available"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/textViewName"
        app:layout_constraintStart_toStartOf="@id/textViewName" >
        <RadioButton
            android:id="@+id/radioButtonavAilableTrue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="В наличии" />

        <RadioButton
            android:id="@+id/radioButtonavAilableFalse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Не в наличии" />
    </RadioGroup>
    <RadioGroup
        android:id="@+id/typeDisk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/available"
        app:layout_constraintStart_toStartOf="@id/available" >
        <RadioButton
            android:id="@+id/radioButtonDVD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DVD" />

        <RadioButton
            android:id="@+id/radioButtonCD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CD" />
    </RadioGroup>

    <TextView
        android:id="@+id/textViewOpis"
        android:textSize="16sp"
        android:layout_width="300dp"
        android:layout_height="170dp"
        tools:text="Описание:"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        app:layout_constraintTop_toBottomOf="@id/typeDisk"
        app:layout_constraintStart_toStartOf="@id/typeDisk" />


</androidx.constraintlayout.widget.ConstraintLayout>